---
import { Picture } from 'astro:assets';
import Logo from './Logo.astro';
import { heroPhotos } from '../data/photos';
import { links, url } from '../config';
---

<section class="hero on-navy">
  <div
    class="photos"
    role="region"
    aria-roledescription="carousel"
    aria-label="Photos from our meetups"
    data-carousel
  >
    {
      heroPhotos.map((photo, i) => (
        <div
          class:list={['slide', { 'is-active': i === 0 }]}
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${heroPhotos.length}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          data-slide
        >
          {i === 0 ? (
            <Picture
              src={photo.src}
              alt={photo.alt}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280, 1600, 2048].filter((w) => w <= photo.src.width)}
              sizes="(max-width: 760px) 100vw, 62vw"
              loading="eager"
              fetchpriority="high"
              style={photo.position ? `object-position: ${photo.position}` : undefined}
            />
          ) : (
            // Later photos sit in a <template> so they don't download with the page;
            // the script adds each one shortly before it's shown.
            <template data-deferred>
              <Picture
                src={photo.src}
                alt={photo.alt}
                formats={['avif', 'webp']}
                widths={[640, 960, 1280, 1600, 2048].filter((w) => w <= photo.src.width)}
                sizes="(max-width: 760px) 100vw, 62vw"
                style={photo.position ? `object-position: ${photo.position}` : undefined}
              />
            </template>
          )}
        </div>
      ))
    }
    <div class="fade fade-left" aria-hidden="true"></div>
    <div class="fade fade-bottom" aria-hidden="true"></div>
    <div class="fade fade-top" aria-hidden="true"></div>

    {
      heroPhotos.length > 1 && (
        <div class="controls">
          <div class="dots">
            {heroPhotos.map((_, i) => (
              <button
                type="button"
                class="dot"
                aria-label={`Show photo ${i + 1}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-dot={i}
              >
                <span />
              </button>
            ))}
          </div>
        </div>
      )
    }
  </div>

  <div class="container inner">
    <div class="copy">
      <Logo size={188} class="hero-logo" eager />
      <h1 data-header-reveal>Tech for Good Community <span class="accent">London</span></h1>
      <p class="intro">
        Monthly meetups for developers, entrepreneurs, <span class="nowrap">non-profits</span>, funders and anyone interested
        in building things that matter.
      </p>
      <div class="ctas">
        <a href={links.luma} class="btn btn-yellow btn-lg">See upcoming events</a>
        <a href={url('/#help')} class="btn btn-outline-light btn-lg">How can we help?</a>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  const slides = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-slide]')) : [];

  if (root && slides.length > 1) {
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    // No auto-advance for people who asked for reduced motion.
    const autoplay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let timer: number | undefined;
    // Paused while the pointer or keyboard focus is on the photos.
    let hoverPaused = false;

    // Insert a deferred photo into the page (starts its download).
    const load = (i: number) => {
      const slide = slides[(i + slides.length) % slides.length];
      const template = slide.querySelector<HTMLTemplateElement>('template[data-deferred]');
      if (template) slide.replaceChildren(template.content.cloneNode(true));
    };

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      load(index);
      load(index + 1); // get the next one ready before it's needed
      slides.forEach((slide, n) => {
        const active = n === index;
        slide.classList.toggle('is-active', active);
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, n) => dot.setAttribute('aria-pressed', String(n === index)));
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (!autoplay || hoverPaused) return;
      timer = window.setInterval(() => show(index + 1), 5000);
    };

    dots.forEach((dot) =>
      dot.addEventListener('click', () => {
        show(Number(dot.dataset.dot));
        start();
      }),
    );
    const pauseTemporarily = (paused: boolean) => {
      hoverPaused = paused;
      start();
    };
    root.addEventListener('mouseenter', () => pauseTemporarily(true));
    root.addEventListener('mouseleave', () => pauseTemporarily(false));
    root.addEventListener('focusin', () => pauseTemporarily(true));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) pauseTemporarily(false);
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // Fetch the second photo once the page itself has finished loading.
    if (document.readyState === 'complete') load(1);
    else window.addEventListener('load', () => load(1), { once: true });

    start();
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  /* ---------- Photos ---------- */
  .photos {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 62%;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .slide.is-active {
    opacity: 1;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fade-left {
    background: linear-gradient(
      to right,
      var(--navy) 0%,
      rgba(16, 32, 74, 0.75) 12%,
      rgba(16, 32, 74, 0.2) 26%,
      rgba(16, 32, 74, 0) 36%
    );
  }

  .fade-bottom {
    background: linear-gradient(to top, var(--navy) 0%, rgba(16, 32, 74, 0.6) 14%, rgba(16, 32, 74, 0) 38%);
  }

  .fade-top {
    background: linear-gradient(to bottom, rgba(16, 32, 74, 0.55) 0%, rgba(16, 32, 74, 0) 18%);
  }

  /* ---------- Controls ---------- */
  .controls {
    display: none;
    position: absolute;
    right: 32px;
    bottom: 92px;
    align-items: center;
    gap: 10px;
  }

  :global(.js) .controls {
    display: flex;
  }

  .dots {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .dot {
    width: 32px;
    height: 44px;
    border: none;
    background: transparent;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .dot span {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.75);
    transition: width 0.3s, background-color 0.3s;
  }

  .dot[aria-pressed='true'] span {
    width: 28px;
    background: var(--yellow);
  }

  /* ---------- Copy ---------- */
  .inner {
    position: relative;
    min-height: 520px;
    padding-top: 48px; /* the header is hidden at the top of the homepage */
    padding-bottom: 160px;
    display: flex;
    align-items: flex-start;
    pointer-events: none;
  }

  .copy {
    max-width: 540px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    pointer-events: auto;
  }

  .copy :global(.hero-logo) {
    width: 188px;
    height: 188px;
    border-radius: 36px;
    position: relative;
    margin-left: -12px; /* the artwork has padding; align the drawing with the heading */
  }

  h1 {
    font-size: 64px;
    line-height: 1.04;
    letter-spacing: -0.01em;
  }

  .accent {
    color: var(--yellow);
  }

  .intro {
    font-size: 20px;
    line-height: 1.55;
    color: var(--on-navy-muted);
    max-width: 520px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
  }

  /* Tablet: the text overlaps more of the photo, so fade further and narrow the photo. */
  @media (min-width: 761px) and (max-width: 1150px) {
    .photos {
      width: 55%;
    }

    .fade-left {
      background: linear-gradient(
        to right,
        var(--navy) 0%,
        rgba(16, 32, 74, 0.85) 20%,
        rgba(16, 32, 74, 0.35) 40%,
        rgba(16, 32, 74, 0) 55%
      );
    }

    .copy {
      max-width: 480px;
    }

    .copy :global(.hero-logo) {
      width: 156px;
      height: 156px;
      border-radius: 30px;
    }

    h1 {
      font-size: 54px;
    }
  }

  /* Mobile: photo banner on top, text below. */
  @media (max-width: 760px) {
    .photos {
      position: relative;
      width: 100%;
      height: 340px;
    }

    .fade-left {
      display: none;
    }

    /* Top-right, out of the way of the big logo at the bottom of the photo. */
    .controls {
      top: 12px;
      bottom: auto;
      right: 12px;
    }

    .inner {
      min-height: 0;
      padding-top: 8px;
      padding-bottom: 112px;
    }

    .copy :global(.hero-logo) {
      width: 136px;
      height: 136px;
      border-radius: 28px;
      margin-top: -92px;
      margin-left: 0;
      box-shadow: 0 0 0 4px var(--navy);
      mix-blend-mode: normal; /* it overlaps the photo here, so keep the solid tile */
    }

    h1 {
      font-size: 44px;
    }

    .intro {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .dot span {
      transition: none;
    }
  }
</style>
