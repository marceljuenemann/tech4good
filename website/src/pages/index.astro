---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NextMeetup from '../components/NextMeetup.astro';
import { links, newsletterEndpoint, url } from '../config';

// Inline stroke icons (24×24 viewBox), drawn in yellow on a navy square.
const helpCards = [
  {
    title: 'Careers in Tech for Good',
    text: 'Find your way into impact work — curated job boards and courses, plus a free career coaching session with someone from the community.',
    cta: 'Explore careers',
    href: url('/careers/'),
    icon: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/>',
  },
  {
    title: 'Build your idea',
    // "non‑profits" uses a non-breaking hyphen (U+2011) so it never splits across lines.
    text: 'Software development and consulting for charities, non‑profits and impact founders — from a free first conversation to pay-what-you-can builds.',
    cta: 'Get tech help',
    href: url('/build/'),
    icon: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>',
  },
  {
    title: 'Funding',
    text: 'Grants, accelerators and impact investors — and warm introductions to people in our community who work in impact VC.',
    cta: 'Find funding',
    href: url('/funding/'),
    icon: '<path d="M12 21v-9"/><path d="M12 12C12 8 9 5 4 5c0 4 3 7 8 7z"/><path d="M12 14c0-3 2.5-6 8-6 0 4-3 6-8 6z"/>',
  },
  {
    title: 'Community',
    text: 'Join our WhatsApp group and meetups, or discover other communities across London working on the causes you care about.',
    cta: 'Find your people',
    href: url('/community/'),
    icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2c3 .1 5.5 2.2 5.5 5.8"/>',
  },
  {
    title: 'Resources',
    text: 'Our community-maintained directory of London tech-for-good communities, causes, job boards, funders and spaces.',
    cta: 'Browse the directory',
    href: url('/resources/'),
    icon: '<path d="M4 19V5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2 2 2 0 0 0 2 2h13"/><path d="M8 7h7M8 11h5"/>',
  },
  {
    title: 'Something else',
    text: 'Not sure where you fit? Tell us what you’re looking for and we’ll point you in the right direction.',
    cta: 'Get in touch',
    href: url('/contact/'),
    icon: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>',
  },
];
---

<BaseLayout shrinkHeader>
  <Hero />
  <NextMeetup />

  <section id="help" class="section help">
    <div class="container stack">
      <div class="heading">
        <h2 class="h2">How can we help?</h2>
        <p class="lead">
          Tell us where you are and we’ll point you to the right resources — and the right people in
          our community.
        </p>
      </div>
      <ul class="cards" role="list">
        {
          helpCards.map((card) => (
            <li>
              <a href={card.href} class="card">
                <span class="icon">
                  <svg
                    aria-hidden="true"
                    width="26"
                    height="26"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={card.icon}
                  />
                </span>
                <span class="card-title">{card.title}</span>
                <span class="card-text">{card.text}</span>
                <span class="card-cta" aria-hidden="true">
                  {card.cta} →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="newsletter on-navy" aria-labelledby="newsletter-title">
    <div class="container row">
      <div class="nl-copy">
        <h2 id="newsletter-title">One email a month</h2>
        <p>Upcoming events, new resources and opportunities from the community. No spam, unsubscribe any time.</p>
      </div>
      <form class="nl-form" method="post" action={newsletterEndpoint} aria-labelledby="newsletter-title">
        <label for="nl-email">Email address</label>
        <div class="nl-row">
          <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
          <button type="submit" class="btn btn-yellow">Subscribe</button>
        </div>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="container about-row">
      <div class="about-copy">
        <p class="eyebrow">About us</p>
        <h2>A community, not an organisation.</h2>
        <p class="lead">
          [FOUNDING STORY — two or three sentences: when and why the community started, and what keeps it going.]
        </p>
        <a href={url('/about/')} class="more-link">Read our story →</a>
      </div>
      <div class="support">
        <h3>Support the community</h3>
        <p class="muted">
          We’re volunteer-run and funded through Open Collective, where every donation and expense is public.
        </p>
        <a href={links.openCollective} class="btn btn-primary">Donate on Open Collective</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .help {
    scroll-margin-top: 80px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 680px;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  @media (max-width: 380px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  .cards li {
    display: flex;
  }

  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    color: var(--ink);
    border-color: var(--navy);
    box-shadow: 0 8px 24px rgba(16, 32, 74, 0.1);
    transform: translateY(-2px);
  }

  .icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--navy);
    color: var(--yellow);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 23px;
    font-weight: 700;
  }

  .card-text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  .card-cta {
    margin-top: auto;
    font-weight: 600;
    color: var(--link);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }

  /* ---------- Newsletter ---------- */
  .newsletter {
    padding: 80px 0;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px 64px;
  }

  .nl-copy {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nl-copy h2 {
    font-size: 38px;
    line-height: 1.15;
    color: var(--yellow);
  }

  .nl-copy p {
    font-size: 18px;
    line-height: 1.55;
    color: var(--on-navy-muted);
  }

  .nl-form {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .nl-form label {
    font-size: 14px;
    font-weight: 600;
    color: var(--on-navy-muted);
  }

  .nl-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .nl-row input {
    flex: 1 1 240px;
    min-width: 0;
    min-height: 52px;
    padding: 14px 18px;
    border: 1.5px solid var(--input-border);
    border-radius: var(--radius-pill);
    font: inherit;
    font-size: 16px;
    background: var(--white);
    color: var(--ink);
  }

  .nl-row .btn {
    min-height: 52px;
    padding: 14px 28px;
  }

  @media (max-width: 760px) {
    .newsletter {
      padding: 56px 0;
    }

    .nl-copy {
      flex-basis: 100%;
    }

    .nl-copy h2 {
      font-size: 32px;
    }

    .nl-row .btn {
      flex: 1 1 100%;
    }
  }

  /* ---------- About teaser ---------- */
  .about-row {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: stretch;
  }

  .about-copy {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }

  .about-copy h2 {
    font-size: 40px;
    line-height: 1.12;
  }

  .about-copy .lead {
    font-size: 18px;
    line-height: 1.65;
  }

  .support {
    flex: 1 1 380px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .support h3 {
    font-size: 24px;
  }

  .support p {
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .about-copy h2 {
      font-size: 32px;
    }

    .support {
      padding: 24px;
    }
  }
</style>
