---
// The single place the logo is used, so it's easy to swap later (e.g. for an SVG).
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import logoWordmark from '../assets/logo-wordmark.jpg';

interface Props {
  size: number;
  variant?: 'icon' | 'wordmark';
  alt?: string;
  class?: string;
  eager?: boolean;
}

const { size, variant = 'icon', alt = '', class: className, eager = false } = Astro.props;
const src = variant === 'wordmark' ? logoWordmark : logo;
---

<Image
  src={src}
  alt={alt}
  width={size}
  height={size}
  densities={[1, 2]}
  class:list={['logo', className]}
  loading={eager ? 'eager' : 'lazy'}
/>

<style>
  .logo {
    display: block;
    border-radius: 22%;
  }
</style>
