---
import Logo from './Logo.astro';
import { links, site, url } from '../config';

export type NavKey = 'help' | 'resources' | 'about' | 'community' | null;

interface Props {
  current?: NavKey;
  /** Homepage only: hide the header until the hero headline is scrolled past. */
  shrink?: boolean;
}

const { current = null, shrink = false } = Astro.props;

const nav: { key: NavKey; label: string; href: string }[] = [
  { key: null, label: 'Events', href: links.luma },
  { key: 'help', label: 'How we help', href: url('/#help') },
  { key: 'resources', label: 'Resources', href: url('/resources/') },
  { key: 'about', label: 'About', href: url('/about/') },
];
---

<header class:list={['site-header on-navy', { 'site-header--shrink': shrink }]} data-header>
  <div class="container inner">
    <a href={url('/')} class="brand" aria-label={`${site.name} — home`}>
      <Logo size={56} class="brand-logo" eager />
      <span class="brand-name" aria-hidden="true">{site.shortName} <span class="brand-city">London</span></span>
    </a>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <svg class="icon-open" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="icon-close" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
      <span class="menu-label">Menu</span>
    </button>

    <nav id="site-nav" aria-label="Main" class="nav">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={item.key && item.key === current ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={url('/community/')}
        class="btn btn-yellow nav-cta"
        aria-current={current === 'community' ? 'page' : undefined}
      >
        Join the community
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('menu-open', open);
  };

  if (header?.classList.contains('site-header--shrink')) {
    // Homepage: the header stays hidden until the hero headline is scrolled past.
    const marker = document.querySelector<HTMLElement>('[data-header-reveal]');
    const update = () => {
      const revealed = marker ? marker.getBoundingClientRect().bottom < 0 : window.scrollY > 140;
      if (!revealed && header.classList.contains('is-revealed')) setOpen(false);
      header.classList.toggle('is-revealed', revealed);
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }

  if (header && toggle) {
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('menu-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--navy-border);
    transition: box-shadow 0.3s, border-color 0.3s;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-top: 18px;
    padding-bottom: 18px;
    transition: padding 0.3s;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--white);
    text-decoration: none;
    transition: opacity 0.3s, transform 0.3s, visibility 0.3s;
  }

  .brand :global(.brand-logo) {
    width: 56px;
    height: 56px;
    border-radius: 12px;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    color: var(--yellow);
    white-space: nowrap;
  }

  .brand-city {
    color: var(--white);
    margin-left: 0.2em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    font-size: 15px;
    font-weight: 500;
  }

  .nav-link {
    color: var(--white);
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    color: var(--white);
    border-bottom-color: var(--on-navy-muted);
  }

  .nav-link[aria-current='page'] {
    border-bottom-color: var(--yellow);
  }

  .nav-cta {
    padding: 11px 20px;
    font-size: 15px;
    min-height: 44px;
  }

  .nav-cta[aria-current='page'] {
    box-shadow: 0 0 0 2px var(--navy), 0 0 0 4px var(--yellow);
  }

  .menu-toggle {
    display: none;
  }

  /* Homepage: the header floats over the page and slides in (compact, with a shadow)
     only after the hero headline has scrolled away. JS-only, so without scripts it's
     a normal header. */
  :global(.js) .site-header--shrink {
    position: fixed;
    left: 0;
    right: 0;
    transform: translateY(-100%);
    visibility: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    transition: transform 0.3s, visibility 0s linear 0.3s;
  }

  :global(.js) .site-header--shrink.is-revealed {
    transform: none;
    visibility: visible;
    transition: transform 0.3s, visibility 0s;
  }

  :global(.js) .site-header--shrink .inner {
    padding-top: 10px;
    padding-bottom: 10px;
  }

  /* ---------- Mobile menu ---------- */
  @media (max-width: 900px) {
    .inner {
      flex-wrap: wrap;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .brand :global(.brand-logo) {
      width: 44px;
      height: 44px;
      border-radius: 10px;
    }

    .brand-name {
      font-size: 20px;
    }

    :global(.js) .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-left: auto;
      min-height: 44px;
      padding: 10px 16px;
      border: 1.5px solid var(--on-navy-muted);
      border-radius: var(--radius-pill);
      background: transparent;
      color: var(--white);
      font: inherit;
      font-weight: 600;
      cursor: pointer;
    }

    .icon-close,
    .menu-open .icon-open {
      display: none;
    }

    .menu-open .icon-close {
      display: block;
    }

    :global(.js) .nav {
      display: none;
    }

    .nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 0 12px;
      font-size: 17px;
    }

    .menu-open .nav {
      display: flex;
    }

    .nav-link {
      padding: 14px 0;
      border-bottom: 1px solid var(--navy-border);
    }

    .nav-link:hover,
    .nav-link[aria-current='page'] {
      border-bottom-color: var(--navy-border);
    }

    .nav-link[aria-current='page'] {
      color: var(--yellow);
    }

    .nav-cta {
      margin-top: 16px;
      align-self: flex-start;
      font-size: 16px;
    }
  }

  /* Narrow phones: keep brand and menu button on one line. */
  @media (max-width: 440px) {
    .inner {
      column-gap: 12px;
    }

    .brand {
      gap: 10px;
    }

    .brand :global(.brand-logo) {
      width: 40px;
      height: 40px;
    }

    .brand-name {
      font-size: 18px;
    }

    :global(.js) .menu-toggle {
      width: 44px;
      padding: 0;
      justify-content: center;
    }

    @media (max-width: 359px) {
      .brand :global(.brand-logo) {
        width: 34px;
        height: 34px;
        border-radius: 8px;
      }

      .brand-name {
        font-size: 16px;
      }
    }

    .menu-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .site-header--shrink,
    :global(.js) .site-header--shrink.is-revealed {
      transition: none;
    }

    .site-header,
    .inner,
    .brand {
      transition: none;
    }
  }
</style>
